  "testNames": [
    "test_constructor_is_passive_and_native_defaults_refused",
    "test_snapshot_has_exact_normalized_three_role_policy",
    "test_six_fresh_callbacks_use254_actual_attempts_and_no_seventh",
    "test_interfaces_are_real_slice_or_service_never_aliases",
    "test_all_systemd_queries_use_same_unique_manager_owner",
    "test_wrong_root_uid_or_pid_or_unbound_owner_is_rejected",
    "test_owner_change_after_open_is_sticky_without_rebind",
    "test_owner_change_during_policy_read_is_rejected",
    "test_invocation_change_during_first_policy_read_is_rejected",
    "test_later_cycle_change_is_rejected_even_when_initial_ids_not_requeried",
    "test_mutable_policy_is_read_again_not_cached",
    "test_zero_duplicate_and_malformed_invocations_rejected",
    "test_missing_property_or_wrong_variant_has_no_fallback",
    "test_wrong_parent_cgroup_state_and_service_policy_rejected",
    "test_actual_requests_cannot_exceed_cap_or_admit_incomplete_snapshot",
    "test_foreign_path_or_write_is_blocked_before_message_allocation",
    "test_disconnected_connection_is_not_reopened",
    "test_late_reply_uses_original_end_and_keeps_independent_close",
    "test_clock_rollback_is_not_hidden_by_integer_nanosecond_rounding",
    "test_failed_close_does_not_retry_and_preserves_read_failure",
    "test_actual_tree_reader_consumes_six_real_abi_snapshots_and_closes",
    "test_summary_is_sanitized_and_never_claims_native_provenance",
    "test_broker_guid_change_refuses_even_if_unique_names_are_reused",
    "test_malformed_or_null_broker_ids_do_not_commit_generation_binding",
    "test_uuid_hex_case_is_normalized_without_rebinding_bus",
    "test_original_manager_peer_mapping_and_request_cleanup_code_unchanged",
    "test_partial_bus_open_remains_owned_for_one_independent_close",
    "test_same_pointer_value_with_replaced_object_is_not_same_bus_generation",
    "test_open_identity_diagnostic_does_not_mask_original_interruption",
    "test_initial_failed_policy_snapshot_never_partially_commits_ids",
    "test_oversize_string_is_rejected_without_echo_in_summary",
    "test_close_interruption_keeps_primary_read_failure_and_does_not_retry",
    "test_fixture_context_lifetime_does_not_depend_on_garbage_collection",
    "test_nested_read_rejection_during_final_reply_cannot_be_overwritten_by_success",
    "test_clock_callback_cannot_enter_before_outer_attempt_is_claimed",
    "test_close_during_active_reply_is_refused_until_owner_unwinds",
    "test_close_reentry_cannot_mutate_outer_close_state_or_error"
  ],
