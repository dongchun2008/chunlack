# Copy to deploy/.env on the VPS. Never commit actual credentials.
LACK_IMAGE_TAG=local
LACK_PORT=3721
LACK_DATA_VOLUME=chunlack_data
LACK_MEMORY_LIMIT=1g
LACK_CPUS=1.0
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Use a private/Tailscale endpoint when the model server is on another host.
OLLAMA_URL=http://host.docker.internal:11434
